#!/usr/bin/env bash
# checkhealth-local
# Tests the bridge API directly on the container port, bypassing nginx.
# Run from /opt/fusionpbx-bridge where .env lives.

set -euo pipefail

ENV_FILE="$(dirname "$0")/.env"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Error: .env not found at $ENV_FILE" >&2
  exit 1
fi

KEY=$(grep -E '^API_KEY=' "$ENV_FILE" | cut -d= -f2)

if [[ -z "$KEY" ]]; then
  echo "Error: API_KEY not found in $ENV_FILE" >&2
  exit 1
fi

echo "Testing container directly on http://localhost:8880 ..."
echo

curl -sf \
  -H "Authorization: Bearer $KEY" \
  http://localhost:8880/health \
  | python3 -m json.tool || {
    echo
    echo "Tip: if the connection was refused, check the container is running:"
    echo "  docker ps | grep fusionpbx-bridge"
    exit 1
  }

